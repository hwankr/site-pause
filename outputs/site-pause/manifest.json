{
  "manifest_version": 3,
  "name": "잠깐, 집중",
  "version": "1.5.0",
  "description": "사이트와 특정 페이지를 차단하고, 사이트별 사용 시간을 확인하세요.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "declarativeNetRequest", "webNavigation", "idle", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "잠깐, 집중",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["http://*/*", "https://*/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
